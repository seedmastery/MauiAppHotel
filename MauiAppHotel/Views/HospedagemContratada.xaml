<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray400}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo" 
               TextColor="{StaticResource White}"
               FontFamily="Kalam"
               FontSize="40"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"/>

        <Border Margin="10"
                Padding="15"
                Stroke="#505050"
                StrokeThickness="2"
                BackgroundColor="Gray">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos:  " 
                           TextColor="White"/>
                    <Label Text=" 2" 
                           TextColor="{StaticResource White}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="  Crianças:    "  
                           TextColor="White"/>
                    <Label Text=" 1" 
                           TextColor="{StaticResource White}"  />

                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <Border Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                    RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: " TextColor="White" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: " TextColor="White" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " TextColor="White"  />

                <Label Grid.Row="1" Grid.Column="0" Text="27/05/2026 " TextColor="White" />
                <Label Grid.Row="1" Grid.Column="1" Text="30/05/2026 " TextColor="White"  />
                <Label Grid.Row="1" Grid.Column="2" Text="3" TextColor="White"  />
            </Grid>
        </Border>

        <Border>
            <HorizontalStackLayout>
                <Label Text="Valor Total: "  TextColor="White" />
                <Label Text="R$ 750,00" TextColor="White" />
            </HorizontalStackLayout>
        </Border>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>

</ContentPage> 